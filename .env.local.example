# Copy this file to .env.local and fill in your connection string.
# Leave MONGODB_URI empty to run in demo mode (mock products, orders are not saved).

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ankara-showcase

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ankara-showcase?retryWrites=true&w=majority

# Admin panel (/admin). Choose a long password, and a random string for ADMIN_SECRET.
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_SECRET=change-me-to-a-long-random-string
